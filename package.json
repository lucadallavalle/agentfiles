{
  "name": "agentfiles",
  "version": "0.0.0",
  "private": true,
  "description": "Personal agent development setup for Claude Code, OpenCode and Codex",
  "scripts": {
    "test": "vitest run",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm build && node dist/generate.js",
    "validate:claude-code": "claude plugin validate --strict .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm validate:claude-code"
  },
  "author": "Luca Dalla Valle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucadallavalle/agentfiles.git"
  },
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.309",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
